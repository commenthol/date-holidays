{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "declarationDir": "./types",
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "skipLibCheck": true,
    "strict": false,
    "target": "ESNext",
    "types": ["node"]
  },
  "include": ["src/**/*.js", "src/**/*.d.ts"],
  "exclude": ["src/data.js"]
}
